+func mustAddrPort(t *testing.T, address net.Addr) netip.AddrPort {
+	t.Helper()
+	value, err := netip.ParseAddrPort(address.String())
+	if err != nil {
+		t.Fatalf("parse address %q: %v", address, err)
+	}
+	return value
+}
